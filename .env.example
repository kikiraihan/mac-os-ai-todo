# Salin ke .env lalu isi:  cp .env.example .env && nano .env
# JANGAN commit .env — berisi password admin awal dan API key.

# Port di localhost VPS tempat app di-publish (reverse proxy host → ke sini).
APP_PORT=8095

# Alamat publik (dipakai sebagai HTTP-Referer ke OpenRouter).
PUBLIC_URL=https://todo.katili.dev

# Akun admin pertama (dibuat sekali saat database masih kosong).
# Server MENOLAK berjalan kalau password masih contoh di bawah.
# Buat dengan: openssl rand -base64 24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GANTI-dengan-password-acak

# Zona waktu bawaan (tiap pengguna bisa mengganti di Pengaturan).
TIMEZONE=Asia/Jakarta

# true karena di depan app ada reverse proxy HTTPS.
SECURE_COOKIES=true
# true kalau di belakang reverse proxy (IP asli dari X-Real-IP / X-Forwarded-For
# untuk batas percobaan login). JANGAN true kalau port app terbuka langsung.
TRUST_PROXY=true

# Kontak untuk layanan Web Push (mailto:...).
VAPID_SUBSCRIBER=mailto:admin@example.com

# --- Provider AI (isi minimal satu). Key hanya di sini, tidak pernah tampil di web.
# kenari: https://kenari.id → API Keys (model ":free" jalan walau saldo nol)
KENARI_API_KEY=
# Agnes AI: https://apihub.agnes-ai.com
AGNES_API_KEY=
# OpenRouter: https://openrouter.ai/keys (model ":free", mis. Qwen)
OPENROUTER_API_KEY=
# Base URL opsional; host di luar allowlist (kenari.id, apihub.agnes-ai.com,
# openrouter.ai) ditolak.
# KENARI_BASE_URL=https://kenari.id/v1
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
